{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "apps/web/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/draft",
        "function": "apiCreateDraft"
      },
      {
        "source": "/api/upload",
        "function": "apiUpload"
      },
      {
        "source": "/api/upload-delete",
        "function": "apiUploadDelete"
      },
      {
        "source": "/api/quote",
        "function": "apiQuote"
      },
      {
        "source": "/api/orders",
        "function": "apiCreateOrder"
      },
      {
        "source": "/api/orders/update-status",
        "function": "apiUpdateOrderStatus"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}